# News Intelligence 라벨링 툴 환경변수 템플릿
#
# 사용법: 이 파일을 .env 로 복사한 뒤 값을 채운다.
# 저장소 루트의 .env 는 API 서버와 scripts 가 시작 시 python-dotenv 로 자동 로드한다
# (이미 export 된 환경변수가 우선; override=False).
#
#   cp .env.example .env
#   uv run --group server --group postgres uvicorn finlabs_intelligence.api.runtime:app --host 127.0.0.1 --port 8000
#
# 실제 .env 는 .gitignore 로 제외된다. 자격증명을 커밋하지 말 것.

# ─────────────────────────────────────────────────────────────
# 필수 — API 서버(finlabs_intelligence.api.runtime) 시작에 모두 필요
# ─────────────────────────────────────────────────────────────

# News Intelligence 저장소(PostgreSQL) libpq 연결 문자열.
# 로컬 Homebrew Postgres 는 role 이 macOS 사용자명이다(보통 'postgres' role 없음):
#   postgresql://YOUR_MACOS_USER@localhost:5432/finlabs_intel
# Supabase: 직접 연결 host(db.PROJECT_REF.supabase.co)는 IPv6 전용이라
#   IPv6 미지원 네트워크에서 DNS 해석이 실패한다. IPv4인 "Session pooler"를 쓸 것
#   (transaction 풀러 6543 금지; Session 풀러는 5432, user 에 .PROJECT_REF 가 붙는다):
#   host=aws-0-REGION.pooler.supabase.com port=5432 dbname=postgres user=postgres.PROJECT_REF password=...
#   (대시보드 Connect → Session pooler 의 문자열을 복사)
#
# ⚠ 비밀번호에 @ # $ % / : ' 같은 특수문자가 있으면 URI 파싱이 깨진다.
#   해결책(권장 순): (1) Supabase 대시보드에서 비밀번호를 영숫자로 재설정,
#   (2) 특수문자를 percent-encode(@→%40, #→%23, $→%24, '→%27, %→%25),
#   (3) URI 대신 키워드 형식 사용(이스케이프 불필요):
#       INTELLIGENCE_DATABASE_URL=host=db.PROJECT_REF.supabase.co port=5432 dbname=postgres user=postgres password=RAW_PASSWORD
INTELLIGENCE_DATABASE_URL=postgresql://YOUR_MACOS_USER@localhost:5432/finlabs_intel

# Kiwoom OpenAPI 자격증명 (분봉 차트·벤치마크 조회용)
KIWOOM_APP_KEY=
KIWOOM_SECRET_KEY=

# Naver 검색 API 자격증명 (직전 1시간 뉴스 검색용)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ─────────────────────────────────────────────────────────────
# 선택 — 테스트 / catalog 적재
# ─────────────────────────────────────────────────────────────

# 스토리지 테스트(tests/news_intelligence)용 PostgreSQL DSN.
# 미설정 시 해당 테스트는 skip 된다. 운영 DB가 아닌 일회용/로컬 DB를 쓸 것.
# (테스트는 매 케이스마다 고유 스키마를 만들고 CASCADE 로 제거하므로
#  역할에 CREATE SCHEMA / DROP SCHEMA 권한이 필요하다.)
INTELLIGENCE_TEST_DATABASE_URL=postgresql://YOUR_MACOS_USER@localhost:5432/finlabs_intel_test

# catalog 를 KIS 직행이 아니라 기존 DuckDB warehouse 에서 seed 할 때만 사용.
# (scripts/seed_intelligence_catalog.py 의 --source 기본값 경로 대신 지정)
# NEWS_DB_PATH=/path/to/news.db
