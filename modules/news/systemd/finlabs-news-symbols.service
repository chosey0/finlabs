[Unit]
Description=Refresh FinLabs news KIS domestic and overseas symbol masters
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=finlabs
WorkingDirectory=/opt/finlabs
# Supply INTELLIGENCE_DATABASE_URL (shared Supabase DSN) and KIS credentials here.
EnvironmentFile=-/etc/finlabs-news.env
ExecStart=/usr/bin/env uv run --group news python -m modules.news.main update-symbols
TimeoutStartSec=30min
